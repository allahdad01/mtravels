a:6:{i:0;a:5:{s:2:"id";i:4;s:4:"name";s:12:"Ahmad Rahimi";s:5:"photo";s:50:"uploads/testimonials/testimonial_68ecd199e9b8c.png";s:11:"testimonial";s:167:"MTravels has completely transformed our travel agency operations. The flight booking system is incredibly efficient and our customer satisfaction has increased by 40%.";s:6:"rating";i:5;}i:1;a:5:{s:2:"id";i:5;s:4:"name";s:12:"Fawad Hassan";s:5:"photo";s:0:"";s:11:"testimonial";s:146:"The visa processing feature is a game-changer. What used to take days now takes hours. Our clients love the transparency and speed of the process.";s:6:"rating";i:5;}i:2;a:5:{s:2:"id";i:6;s:4:"name";s:12:"Mohammad Ali";s:5:"photo";s:0:"";s:11:"testimonial";s:134:"Outstanding hotel booking system with real-time availability. The integration with major hotel chains has made our job so much easier.";s:6:"rating";i:5;}i:3;a:5:{s:2:"id";i:8;s:4:"name";s:11:"Omar Farooq";s:5:"photo";s:0:"";s:11:"testimonial";s:135:"Customer management has never been easier. The CRM features help us personalize experiences and track customer preferences effectively.";s:6:"rating";i:5;}i:4;a:5:{s:2:"id";i:7;s:4:"name";s:8:"Ali Khan";s:5:"photo";s:0:"";s:11:"testimonial";s:149:"The financial management tools are excellent. Multi-currency support and automated invoicing have streamlined our accounting processes significantly.";s:6:"rating";i:4;}i:5;a:5:{s:2:"id";i:9;s:4:"name";s:11:"Zakir Ahmad";s:5:"photo";s:0:"";s:11:"testimonial";s:139:"The analytics dashboard provides valuable insights into our business performance. We can now make data-driven decisions to grow our agency.";s:6:"rating";i:4;}}